{
  "expo": {
    "name": "Xido",
    "slug": "xido",
    "version": "999.99",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "myapp",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nativcodes.xido",
      "buildNumber": "4"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.nativcodes.xido"
    },
    "plugins": [
      "expo-router",
      "expo-document-picker",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#12d18e",
          "imageWidth": 120
        }
      ],
      "fastlane-kit",
      "fastlane-kit/optional-portrait"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
